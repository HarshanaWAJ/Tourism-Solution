PORT=4000
MONGO_URI=mongodb://localhost:27017/lanka_tourism
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Optional: path to the local GGUF model used by the AI planner/chat.
# Defaults to backend/models/model.gguf if unset. No API key required —
# see backend/models/README.md for how to get a model file.
# LLM_MODEL_PATH=./models/model.gguf

# Stripe (taxi ride card payments) — see README.md "Stripe setup" section
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OSRM routing server for taxi ride distance/duration/route geometry.
# Defaults to the public demo server (fine for dev, not for production load).
# OSRM_BASE_URL=https://router.project-osrm.org
